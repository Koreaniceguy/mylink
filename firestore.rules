rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 헬퍼 함수 (Helper Functions)
    // ==========================================

    // 로그인된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 요청자가 해당 경로의 소유자(본인)인지 확인
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. users/{userId} (사용자 메인 프로필 문서)
    // - displayName, email, photoURL, profile, theme 등
    // - 동적 라우팅 /[displayName] where 쿼리를 위해 누구나 읽기 허용
    // ==========================================
    match /users/{userId} {
      // 읽기: 누구나 가능 (비로그인 방문자도 프로필 열람 및 where 쿼리 검색 허용)
      allow read: if true;

      // 생성/수정: 본인만 가능
      // (단, 방문자의 pageViews 단순 증가를 허용하려면 아래 isPageViewOnlyIncrement() 조건 활용 가능)
      allow create, delete: if isOwner(userId);
      
      allow update: if isOwner(userId) || isPageViewIncrementOnly();

      // [추가 보안 규칙] 방문자의 프로필 조회수(pageViews) 1 증가만 예외적으로 허용하는 규칙
      function isPageViewIncrementOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pageViews', 'updatedAt'])
          && request.resource.data.pageViews == resource.data.pageViews + 1;
      }

      // ==========================================
      // 2. users/{userId}/links/{linkId} (링크 목록 서브컬렉션)
      // ==========================================
      match /links/{linkId} {
        // 읽기: 누구나 가능 (비로그인 방문자도 공개 링크 목록 조회 가능)
        allow read: if true;

        // 생성/삭제: 본인만 가능
        allow create, delete: if isOwner(userId);

        // 수정: 본인 전체 수정 가능 OR 방문자의 링크 클릭 수(clicks) 1 증가 허용
        allow update: if isOwner(userId) || isClickIncrementOnly();

        // [추가 보안 규칙] 방문자의 링크 클릭 수(clicks) 1 증가만 예외적으로 허용
        function isClickIncrementOnly() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
            && request.resource.data.clicks == resource.data.clicks + 1;
        }
      }

      // ==========================================
      // 3. users/{userId}/profile/{profileId} (프로필 상세 서브컬렉션)
      // - 프로필이 서브컬렉션으로 분리되어 저장되는 경우 대응
      // ==========================================
      match /profile/{profileId} {
        // 읽기: 누구나 가능 (명함 프로필 정보 열람)
        allow read: if true;

        // 쓰기: 본인 ID 일치 시만
        allow write: if isOwner(userId);
      }
    }

    // ==========================================
    // 기본 차단: 정의되지 않은 기타 경로는 모두 차단
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
